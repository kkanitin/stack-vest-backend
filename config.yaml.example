server:
  port: "8080"
  read_header_timeout_seconds: 10   # optional; defaults to 10 if unset
  read_timeout_seconds: 30          # optional; defaults to 30 if unset
  idle_timeout_seconds: 120         # optional; defaults to 120 if unset
  # write_timeout is intentionally not configurable: a global write deadline
  # would cut off the SSE analysis stream (POST /api/v1/portfolios/:id/analyze).

log:
  level: "info"       # debug | info | warn | error
  format: "json"      # json | text

db:
  postgres:
    dsn: "postgres://user:password@localhost:5432/stackvest?sslmode=disable"
  migrate:
    enabled: true   # set to false to skip auto-migration on startup

auth:
  google:
    client_id: "YOUR_GOOGLE_CLIENT_ID"
    client_secret: "YOUR_GOOGLE_CLIENT_SECRET"
    redirect_url: "http://localhost:8080/api/v1/auth/google/callback"
  jwt:
    secret: "YOUR_JWT_SECRET_CHANGE_ME"

third_party_api:
  fmp:
    api_key: "YOUR_FMP_API_KEY"
  groq:
    api_key: "YOUR_GROQ_API_KEY"

redis:
  addr: "localhost:6379"   # host:port of the Redis used for the dividend cache
  password: ""
  db: 0

cors:
  allow_origins:
    - "http://localhost:5173"   # add your frontend origin(s) here

portfolio:
  max_per_user: 10                  # max portfolios a single user can own
  max_positions_per_portfolio: 20   # max positions within one portfolio
  # Indices a portfolio value history can be compared with (GET /portfolios/benchmarks).
  # Each entry is "SYMBOL=Label" ('=' because a "SYMBOL: Label" entry would parse as a YAML map).
  # Env var PORTFOLIO_BENCHMARKS takes a comma-separated list; entries are trimmed.
  benchmarks:
    - "SPY=S&P 500"
    - "QQQ=Nasdaq 100"
    - "VT=Total world"

market:
  heatmap:
    # Index heatmaps (S&P 500, Nasdaq 100, Dow 30) are rebuilt in the background on this interval.
    refresh_minutes: 5
    # How long a symbol's 1D/1W/1M/YTD change is reused before it is fetched again (tile colour freshness).
    change_ttl_minutes: 10
    # Cap on FMP calls per minute (company profiles + price changes) made by the refresh. Keep it well
    # under your plan's limit (Starter: 300/min) so interactive requests still have budget.
    calls_per_minute: 150
